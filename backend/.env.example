ENVIRONMENT=development
DEBUG=True
APP_NAME=LinkFlow
BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://linkflow:linkflow_password@localhost:5432/linkflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=linkflow-dev-secret-key-change-in-production-must-be-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REDIRECT_PER_SEC=100
RATE_LIMIT_CREATE_PER_MIN=30
RATE_LIMIT_AUTH_PER_MIN=5

# Analytics Stream
REDIS_STREAM_KEY=clicks:stream
REDIS_STREAM_GROUP=linkflow_analytics_workers
REDIS_STREAM_CONSUMER=worker_1
